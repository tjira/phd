\newcommand{\e}{\symrm{e}} % Euler's number
\newcommand{\dt}{\symrm{d}t} % differential operator for time
\newcommand{\ddt}{\frac{\symrm{d}}{\dt}} % total time derivative

\newtheorem{definition}{Definition}\numberwithin{definition}{section} % definition environment
\newtheorem{theorem}{Theorem}\numberwithin{theorem}{section} % theorem environment

\renewcommand{\i}{\symrm{i}} % imaginary unit

\definecolor{chapdark}{HTML}{0D2B40} % dark blue for the title and horizontal line
\definecolor{chapgold}{HTML}{D1A86F} % gold for the chapter circle

\setkomafont{part}{\fontsize{32}{38}\selectfont\bfseries\sffamily\color{chapdark}\centering} % part title formatting
\setkomafont{chapter}{\Huge\bfseries\sffamily\color{chapdark}\raggedright} % chapter title formatting
\setkomafont{section}{\Large\bfseries\sffamily\color{chapdark}\raggedright} % section title formatting
\setkomafont{subsection}{\large\bfseries\sffamily\color{chapdark}\raggedright} % subsection title formatting
\setkomafont{subsubsection}{\normalsize\bfseries\sffamily\color{chapdark}\raggedright} % subsubsection title formatting

\makeatletter
\renewcommand*{\partlineswithprefixformat}[3]{
  \begin{center}
  \begin{tikzpicture}[baseline=(current bounding box.center)]
    \draw[chapdark, line width=4.5pt] (-0.48\textwidth,0) -- (0.48\textwidth,0);
    \Ifstr{#2}{}{}{
      \node[
        draw=chapgold,
        line width=2.5pt,
        circle,
        fill=white,
        minimum size=4.5cm,
        font=\sffamily\color{chapdark},
        align=center,
        inner sep=0pt
      ] at (0,0) {\Large PART\\[3ex]\fontsize{42}{48}\selectfont\bfseries \thepart};
    }
  \end{tikzpicture}\par
  \vspace{1.5cm}
  {\usekomafont{part}#3\par}
  \end{center}
}
\makeatother

\makeatletter
\renewcommand*{\chapterlinesformat}[3]{
  \vspace*{-2cm}
  \begin{tikzpicture}[baseline=(current bounding box.north)]
    \draw[chapdark,line width=3.5pt] (0,0) -- (0.99\textwidth,0);
    \Ifstr{#2}{}{}{
      \node[
        draw=chapgold,
        line width=2pt,
        circle,
        fill=white,
        minimum size=3cm,
        font=\sffamily\large\color{chapdark},
        inner sep=0pt
      ] at (\textwidth - 2.5cm,0) {Chapter \thechapter};
    }
  \end{tikzpicture}\par
  \vspace{2ex}
  {\usekomafont{chapter}#3\par}
}
\makeatother

\makeatletter
\renewcommand*{\sectionlinesformat}[4]{
  \Ifstr{#1}{section}{
    \ensuremath{\vcenter{\hbox{\color{chapgold}\rule{4pt}{1.4em}}}}\enspace#3#4
  }{
    \Ifstr{#1}{subsection}{
      \ensuremath{\vcenter{\hbox{\color{chapgold}\rule{3pt}{1.2em}}}}\enspace#3#4
    }{
      \Ifstr{#1}{subsubsection}{
        \ensuremath{\vcenter{\hbox{\color{chapgold}\rule{2pt}{1em}}}}\enspace#3#4
      }
    }
  }
}
\makeatother
