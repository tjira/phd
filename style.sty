\RequirePackage{pdfmanagement}\SetKeys[document/metadata]{pdfversion=1.7,pdfstandard=a-3b}

\RequirePackage[onehalfspacing]{setspace} % setting the line spacing
\RequirePackage[top=25mm,bottom=25mm,inner=25mm,outer=25mm,bindingoffset=10mm]{geometry} % page composition
\RequirePackage[hidelinks,linktoc=all]{hyperref} % hyperlinks and metadata
\RequirePackage[backend=biber,style=chem-acs]{biblatex} % bibliography package
\RequirePackage{braket} % braket notation
\RequirePackage[acronym,nogroupskip,nomain,toc]{glossaries} % glossary package
\RequirePackage[automark]{scrlayer-scrpage} % page styles
\RequirePackage{unicode-math} % unicode math support
\RequirePackage[nopatch=footnote]{microtype} % better typesetting
\RequirePackage{tikz} % graphics
\RequirePackage{luacode} % Lua code embedding
\RequirePackage{pdfpages} % including PDF files
\RequirePackage{subcaption} % subfigures
\RequirePackage{enumitem} % better lists
\RequirePackage[version=4]{mhchem} % chemical formulas
\RequirePackage{xcolor} % custom colors
\RequirePackage{bookmark} % better PDF bookmarks

\hypersetup{pdftitle={\@title},pdfauthor={\@author}} % set PDF metadata from the title and author defined in the main document

\hypersetup{pdfpagemode=UseOutlines,pdfdisplaydoctitle=true,bookmarksnumbered=true,bookmarksopen=true,bookmarksopenlevel=0} % set PDF viewing options and bookmark behavior

\ifnum\directlua{tex.print(os.getenv("ONLINE")=="1" and 1 or 0)}=1
    \geometry{bindingoffset=0mm,margin=25mm} % adjust margins for online viewing
\fi

\ifnum\directlua{tex.print(os.getenv("ONLINE")=="1" and 1 or 0)}=1
    \hypersetup{colorlinks=true,linkcolor=blue,citecolor=magenta,urlcolor=blue} % enable colored links for online viewing
\fi

\addbibresource{library.bib}\makeglossaries % set the library file and make glossaries

\clearpairofpagestyles % clear the default page styles
\ihead{\pagemark} % add page number to the inner header
\ohead{\headmark} % add chapter name to the outer header

\captionsetup{labelfont=bf} % caption label bold
\captionsetup{font=small} % caption font size small
\captionsetup{format=plain} % caption format plain to avoid hanging indentation

\setmainfont{Libertinus Serif} % set the main font
\setmathfont{Libertinus Math} % set the math font
\setsansfont{Libertinus Sans} % set the sans-serif font

